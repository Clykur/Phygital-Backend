{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./lib/db/src/index.ts"],
      "@workspace/db/schema": ["./lib/db/src/schema/index.ts"],
      "@workspace/api-zod": ["./lib/api-zod/src/index.ts"],
      "express": ["./node_modules/@types/express/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "lib/db"
    },
    {
      "path": "lib/api-zod"
    }
  ]
}
